{
  "schemaVersion": 1,
  "id": "con-tag",
  "connector": "…, isn't it?",
  "gloss": "〜ですよね（確かめる）",
  "title": "…, isn't it? — 〜ですよね（確かめる）",
  "pattern": "文 , isn't it? ／ 否定の文 , does it?",
  "explanation": "文の最後に短い質問を付けると、「〜ですよね」と確かめたり同意を求めたりする言い方になります。前が肯定なら否定の形（It's on special, isn't it?）、前が否定なら肯定の形（It doesn't come in navy, does it?）を付けます。",
  "natural": "天気の話や、確かめたい時に。会話のきっかけにもなります。ニュージーランドでは、文の最後に eh?（ね？）を付けることもよくあります。",
  "stiff": "主語や動詞に合わせて形が変わるので、最初は短い文で練習しましょう。迷ったら right?（だよね？）でも通じます。",
  "examples": [
    {
      "id": "cx-tag-1",
      "english": "You're open on Sunday, aren't you?",
      "japanese": "日曜日も開いていますよね？",
      "chunks": [
        {
          "t": "You're open ",
          "w": "w-open"
        },
        {
          "t": "on Sunday, "
        },
        {
          "t": "aren't you?"
        }
      ],
      "gap": {
        "before": "You're open on Sunday, ",
        "answer": "aren't you",
        "after": "?",
        "options": [
          "aren't you",
          "isn't it",
          "don't you"
        ],
        "why": "主語が you で、are の文なので aren't you?"
      },
