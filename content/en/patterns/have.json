{
  "schemaVersion": 1,
  "id": "pat-have",
  "connector": "Can I have…?",
  "gloss": "〜をもらえますか",
  "title": "Can I have…? — 〜をもらえますか",
  "pattern": "Can I have ＋ もの ＋ , please?",
  "explanation": "Can I have ...? は「〜をもらえますか」。店員さんに何かを頼む、いちばん基本の言い方です。指さしながら Can I have this one? と言えば、名前がわからない物でも頼めます。よりていねいにしたい時は Could I have ...? に。",
  "natural": "カフェ、パン屋さん、お店のレジ、どこでも使えます。please を付ければ十分ていねいです。",
  "stiff": "Give me ... は命令に聞こえるので、店員さんには使わないようにしましょう。",
  "examples": [
    {
      "id": "px-have-1",
      "english": "Can I have a paper bag, please?",
      "japanese": "紙袋をもらえますか？",
      "chunks": [
        {
          "t": "Can I have "
        },
        {
          "t": "a paper bag, ",
          "w": "w-paper-bag"
        },
        {
          "t": "please?"
        }
      ],
      "gap": {
        "before": "Can I ",
        "answer": "have",
        "after": " a paper bag, please?",
        "options": [
          "have",
          "give",
          "do"
        ],
        "why": "「もらう」は have。give は「あげる」、do は「する」です。"
      },
      "audio": "audio/en/patterns/px-have-1.mp3",
      "tags": [
