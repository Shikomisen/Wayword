{
  "schemaVersion": 1,
  "id": "gr-continuous",
  "connector": "-ing",
  "gloss": "今〜している",
  "title": "be ＋ -ing — 今〜しています",
  "pattern": "am・is・are ＋ 動詞-ing",
  "explanation": "今まさにしていることは、be動詞 ＋ 動詞の -ing 形：I’m cooking.（今、料理しています）、It’s raining.（雨が降っています）。e で終わる語は e を取って -ing（make → making）。短い語は最後の文字を重ねることがあります（run → running、sit → sitting）。",
  "natural": "電話やメッセージでよく使います：What are you doing?（何してる？）―― I’m watching TV.（テレビ見てる）。",
  "stiff": "be動詞を落とすのは×：I cooking. ではなく I’m cooking.know、like、want のような「状態」の動詞は -ing にしません：I’m knowing. は×。",
  "examples": [
    {
      "id": "gx-continuous-1",
      "english": "I’m cooking dinner.",
      "japanese": "夕食を作っています。",
      "chunks": [
        {
          "t": "I’m ",
          "w": "w-i"
        },
        {
          "t": "cooking ",
          "w": "w-cook"
        },
        {
          "t": "dinner."
        }
      ],
      "gap": {
        "before": "I’m ",
        "answer": "cooking",
        "after": " dinner.",
        "options": [
          "cooking",
          "cook",
          "cooked"
        ],
        "why": "今していること：be ＋ -ing。"
      },
      "audio": "audio/en/grammar/gx-continuous-1.mp3",
      "tags": [
        "文法",
        "-ing"
      ],
      "difficulty": 1
    },
