{
  "schemaVersion": 1,
  "id": "gr-used-to",
  "connector": "used to",
  "gloss": "前は〜だった",
  "title": "used to — 前はよく〜した、前は〜だった",
  "pattern": "I used to … ／ I didn’t use to … ／ Did you use to …?",
  "explanation": "used to ＋ 動詞の原形で、「（今はちがうけれど）前はよく〜した、前は〜だった」。I used to live in Osaka.（前は大阪に住んでいました）。否定と疑問では use to（d なし）：I didn’t use to like coffee.",
  "natural": "昔の習慣や変化を話す時に：I used to play rugby.（昔ラグビーをしていました）",
  "stiff": "「〜に慣れている」は be used to ＋ -ing という別の表現です：I’m used to driving on the left.（左側通行には慣れています）。混ぜないように。",
  "examples": [
    {
      "id": "gx-used-to-1",
      "english": "I used to live in Osaka.",
      "japanese": "前は大阪に住んでいました。",
      "chunks": [
        {
          "t": "I used to live ",
          "w": "w-live"
        },
        {
          "t": "in Osaka."
        }
      ],
      "gap": {
        "before": "I ",
        "answer": "used to",
        "after": " live in Osaka.",
        "options": [
          "used to",
          "use to",
          "was used to"
        ],
        "why": "「前は〜した」は used to ＋ 原形。"
      },
      "audio": "audio/en/grammar/gx-used-to-1.mp3",
      "tags": [
        "文法",
        "used to"
      ],
      "difficulty": 3
    },
