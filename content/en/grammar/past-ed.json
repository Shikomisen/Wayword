{
  "schemaVersion": 1,
  "id": "gr-past-ed",
  "connector": "-ed",
  "gloss": "〜した（過去形）",
  "title": "-ed — 〜した（過去形）",
  "pattern": "動詞 ＋ -ed（work → worked、live → lived、stop → stopped）",
  "explanation": "過去のことは過去形で言います。多くの動詞は -ed を付けるだけ：work → worked、watch → watched。e で終わる語は -d だけ（live → lived）。主語が he・she でも形は同じです。発音は3通り：worked（ト）、lived（ド）、wanted（イド）。",
  "natural": "週末や昨日のことを話す時に：I watched a movie last night.（昨夜、映画を見ました）。",
  "stiff": "yesterday や last week があるのに現在形のままにしがちです：Yesterday I work. は×、Yesterday I worked.。",
  "examples": [
    {
      "id": "gx-past-ed-1",
      "english": "I watched a movie last night.",
      "japanese": "昨夜、映画を見ました。",
      "chunks": [
        {
          "t": "I ",
          "w": "w-i"
        },
        {
          "t": "watched a movie ",
          "w": "w-watch"
        },
        {
          "t": "last night.",
          "w": "w-night"
        }
      ],
      "gap": {
        "before": "I ",
        "answer": "watched",
        "after": " a movie last night.",
        "options": [
          "watched",
          "watch",
          "watching"
        ],
        "why": "last night は過去：watch → watched。"
      },
