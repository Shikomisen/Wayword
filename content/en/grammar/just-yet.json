{
  "schemaVersion": 1,
  "id": "gr-just-yet",
  "connector": "just / yet",
  "gloss": "ちょうど・もう・まだ",
  "title": "just, already, yet — ちょうど〜した、もう、まだ",
  "pattern": "I’ve just … ／ I’ve already … ／ Have you … yet? ／ I haven’t … yet.",
  "explanation": "have ＋ 過去分詞は、今につながる「（もう）〜した」にも使います。just は「ちょうど今」、already は「もう、すでに」。yet は疑問文で「もう？」、否定文で「まだ（〜していない）」の意味になり、文の最後に置きます。",
  "natural": "用事が済んだか確かめる時に：Have you eaten yet?（もう食べた？）、I’ve just arrived.（今着いたところ）",
  "stiff": "日本語の「まだ」につられて I still didn’t eat. と言うのは不自然。I haven’t eaten yet.",
  "examples": [
    {
      "id": "gx-just-yet-1",
      "english": "I’ve just arrived at the airport.",
      "japanese": "たった今、空港に着いたところです。",
      "chunks": [
        {
          "t": "I’ve ",
          "w": "w-i"
        },
        {
          "t": "just arrived "
        },
        {
          "t": "at the airport."
        }
      ],
      "gap": {
        "before": "I’ve ",
        "answer": "just",
        "after": " arrived at the airport.",
        "options": [
          "just",
          "yet",
          "still"
        ],
        "why": "ちょうど今したことは just。have と過去分詞の間に置きます。"
      },
      "audio": "audio/en/grammar/gx-just-yet-1.mp3",
      "tags": [
        "文法",
        "just / yet"
      ],
      "difficulty": 3
    },
