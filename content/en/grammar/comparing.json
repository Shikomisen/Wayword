          "w": "w-windy"
        },
        {
          "t": "than Auckland."
        }
      ],
      "gap": {
        "before": "Wellington is windier ",
        "answer": "than",
        "after": " Auckland.",
        "options": [
          "than",
          "that",
          "then"
        ],
        "why": "比べる相手の前は than。"
      },
