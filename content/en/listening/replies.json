      "difficulty": 1
    },
    {
      "id": "lr-02",
      "speaker": "staff",
      "english": "Would you like a bag?",
      "japanese": "袋はご入用ですか？",
      "reply": "No thanks, I'm fine.",
      "replyJapanese": "いいえ、大丈夫です。",
      "audio": "audio/en/listening/lr-02.mp3",
      "tags": [
