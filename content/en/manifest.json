  "lessonGroups": [
    {
      "id": "first-sentence",
      "title": "文の基本",
      "description": "be動詞、this と that、a と the、複数形、my と your、there is、場所と時の前置詞。英語の文の骨組みです。"
    },
    {
      "id": "first-verbs",
      "title": "動詞の基本",
      "description": "現在形・否定・can・-ing・過去形・質問の形。毎日のことを話すための動詞の使い方。"
    },
    {
      "id": "ask",
      "title": "お願いする",
      "description": "注文や頼みごとの型。○○を入れかえれば、いろいろな場面で使えます。"
    },
    {
      "id": "question",
      "title": "たずねる",
      "description": "ある？ これは〜？ どこ？ いくら？ を聞く型。"
    },
    {
      "id": "polite",
      "title": "ていねいに頼む・断る",
      "description": "相手に何かをしてもらう、許可をもらう、やわらかく断る。英語らしい「ていねいさ」の作り方。"
    },
    {
      "id": "link",
      "title": "つなぎ言葉",
      "description": "so, but, because など、文と文をつなぐ言葉。理由や気持ちも一緒に伝えられるようになります。"
    },
    {
      "id": "order",
      "title": "語順・質問の形",
      "description": "日本語と順番がちがうところ。英語らしい語順と、質問や答えの形を練習します。"
    },
    {
      "id": "tenses",
      "title": "時制：経験・予定・昔のこと",
      "description": "have been、will と going to、used to。いつのことかを正しく伝える形。"
    },
    {
      "id": "modals",
      "title": "助動詞：アドバイス・義務・可能性",
      "description": "should、have to、might。「〜したほうがいい」「〜しなければ」「〜かも」。"
    },
    {
      "id": "conditionals",
      "title": "もしも",
      "description": "if と wish。起こりそうな「もし」と、現実とちがう「もし」。"
    },
    {
      "id": "structures",
      "title": "文の組み立て",
      "description": "比べる、〜すぎる、-ing と to、名詞の説明、受け身、〜させる。"
    },
    {
      "id": "conversation",
      "title": "会話の形",
      "description": "ていねいに聞く、人の話を伝える、提案する、「私も」と言う。"
    }
  ],
