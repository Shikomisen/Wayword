{
  "schemaVersion": 1,
  "id": "kanji-words",
  "kind": "characters",
  "title": "Kanji di kata-katamu",
  "script": "kanji",
  "description": "Kanji di balik dek kata: pelajari hurufnya di sini, lalu kamu akan terus bertemu dengannya di 食べる, 来週, 電車. Untuk dikenali, bukan untuk ditulis.",
  "groups": [
    {
      "id": "people",
      "title": "Orang & dasar",
      "description": "Siapa dan apa: kanji dalam kata-kata tentang orang."
    },
    {
      "id": "time",
      "title": "Waktu",
      "description": "Pagi, malam, minggu ini, dan minggu depan."
    },
    {
      "id": "actions",
      "title": "Kata kerja sehari-hari",
      "description": "Satu kanji, lalu hiragana: 食べる, 飲む, 見る. Kanji membawa arti, kana membawa tata bahasa: saat kata kerjanya berubah bentuk, hanya bagian kana yang berubah."
    },
    {
      "id": "describe",
      "title": "Sifat & perasaan",
      "description": "Kata sifat, dan 気 dalam 元気 dan 天気."
    },
    {
      "id": "places",
      "title": "Tempat & benda",
      "description": "Toko, sekolah, kantor, dan bepergian."
    },
    {
      "id": "nature",
      "title": "Cuaca & musim",
      "description": "Jepang punya empat musim, bukan dua seperti Indonesia, dan setiap musim ditulis dengan satu kanji."
    },
    {
      "id": "work",
      "title": "Kerja & belajar",
      "description": "Termasuk dua kata yang kanjinya hanya bermakna jika berpasangan."
    }
  ],
