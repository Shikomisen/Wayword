  "lessonGroups": [
    {
      "id": "particles",
      "title": "Partikel: menyusun kalimat",
      "description": "Kata-kata kecil setelah kata benda yang menunjukkan siapa melakukan apa, di mana, kapan, dan dengan siapa."
    },
    {
      "id": "verbs",
      "title": "Kata kerja & kata sifat",
      "description": "Kata kerja sopan dan santai, kata untuk menggambarkan sesuatu, dan cara bilang apa yang ingin kamu lakukan."
    },
    {
      "id": "chain",
      "title": "Dan, lalu",
      "description": "Merangkai tindakan dan menambahkan hal lain."
    },
    {
      "id": "reason",
      "title": "Karena & jadi",
      "description": "Memberi alasan dan menarik kesimpulan."
    },
    {
      "id": "contrast",
      "title": "Tapi",
      "description": "Dua hal yang saling bertentangan."
    },
    {
      "id": "condition",
      "title": "Kalau & ketika",
      "description": "Syarat, dan kapan sesuatu terjadi."
    },
    {
      "id": "more",
      "title": "Sambil, lagi pula, supaya",
      "description": "Melakukan dua hal sekaligus, menumpuk alasan, dan menyatakan tujuan."
    },
    {
      "id": "forms",
      "title": "Bentuk kata kerja yang menambah makna",
      "description": "Mencoba, menyelesaikan, menyiapkan, pengalaman, rencana, kemampuan, perubahan, dan keputusan: akhiran kata kerja yang paling banyak dipakai dalam percakapan."
    },
    {
      "id": "rules",
      "title": "Boleh, harus & tidak perlu",
      "description": "Minta izin, bilang apa yang tidak boleh, dan apa yang harus atau tidak perlu kamu lakukan."
    },
    {
      "id": "giving",
      "title": "Memberi & menerima",
      "description": "Siapa memberi kepada siapa, dan saling membantu: kata kerja yang dipakai bahasa Jepang untuk menunjukkan rasa terima kasih."
    },
    {
      "id": "thinking",
      "title": "Menyampaikan pikiran & kabar",
      "description": "Pendapat, menyampaikan ucapan orang, kemungkinan, kesan dari yang terlihat, dan apa yang kamu dengar."
    },
    {
      "id": "nuance",
      "title": "Nuansa dalam percakapan",
      "description": "Akhiran dan pola yang membuat bahasa Jepang terdengar seperti percakapan: menjelaskan, berbagi, mengeluh, mengakui, membandingkan."
    },
    {
      "id": "keigo",
      "title": "Bahasa Jepang sopan (keigo)",
      "description": "Kata kerja hormat untuk lawan bicara dan kata kerja merendah untuk diri sendiri: untuk keluarga pasangan, pelanggan, dan siapa pun yang kedudukannya di atasmu."
    }
  ],
