    {
      "id": "gx-takotogaaru-1",
      "japanese": "日本に行ったことがありますか。",
      "furigana": "{日本|にほん}に{行|い}ったことがありますか。",
      "indonesian": "Apakah Anda pernah ke Jepang?",
      "register": "polite",
