  "lessonGroups": [
    {
      "id": "sentence",
      "title": "Building a sentence",
      "description": "No “to be”, ini and itu, the pronouns, possession, and the noun before its describing word."
    },
    {
      "id": "asking",
      "title": "Questions and saying no",
      "description": "tidak and bukan, the question words, yes-or-no questions, ada and punya."
    },
    {
      "id": "verbs",
      "title": "Verbs and time",
      "description": "Verbs that never change, mau and bisa, time words instead of tenses, where to and from, counting, and asking politely."
    },
    {
      "id": "chain",
      "title": "And, and then",
      "description": "Joining actions and adding things on."
    },
    {
      "id": "reason",
      "title": "Because and so",
      "description": "Giving a reason, and saying what follows from it."
    },
    {
      "id": "contrast",
      "title": "But",
      "description": "Saying the opposite, or the unexpected."
    },
    {
      "id": "when",
      "title": "If, when, before and after",
      "description": "Conditions and the order things happen in."
    },
    {
      "id": "purpose",
      "title": "While, and so that",
      "description": "Doing two things at once, and saying what something is for."
    },
    {
      "id": "affixes",
      "title": "Prefixes and suffixes",
      "description": "How ber-, me-, di-, -kan, -i, ter- and ke-…-an change a root word, and why written Indonesian looks longer than spoken."
    },
    {
      "id": "describe",
      "title": "Comparing and describing",
      "description": "Nouns made from verbs, as … as, more and most, yang, and saying a word twice."
    },
    {
      "id": "conversation",
      "title": "The words of real conversation",
      "description": "-nya, pernah, masih and lagi, the particles kok, sih, dong, deh and kan, reporting what someone said, guessing, and asking politely."
    }
  ],
