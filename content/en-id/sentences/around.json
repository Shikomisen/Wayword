      ],
      "difficulty": 2
    },
    {
      "id": "s-34",
      "indonesian": "Saya tidak makan daging, tapi ikan boleh.",
      "english": "I don't eat meat, but fish is fine.",
      "chunks": [
        {
          "t": "Saya ",
          "w": "w-saya"
        },
        {
          "t": "tidak makan ",
          "w": "w-makan"
        },
        {
          "t": "daging, ",
          "w": "w-daging"
        },
        {
          "t": "tapi ",
          "w": "w-tapi"
        },
        {
          "t": "ikan boleh.",
          "w": "w-ikan"
        }
      ],
      "registerNotes": "Saying what you can eat as well as what you can't makes ordering easier. Boleh (allowed) here means 'fine, OK'.",
      "audio": "audio/id/sentences/s-34.mp3",
      "tags": [
        "food",
        "diet"
      ],
      "difficulty": 2
    },
    {
      "id": "s-35",
      "indonesian": "Mangga ini berapa sekilo, Bu?",
      "english": "How much are these mangoes a kilo?",
      "chunks": [
        {
          "t": "Mangga "
        },
        {
          "t": "ini ",
          "w": "w-ini"
        },
        {
          "t": "berapa ",
          "w": "w-berapa"
        },
        {
          "t": "sekilo, "
        },
        {
          "t": "Bu?",
          "w": "w-ibu"
        }
      ],
      "registerNotes": "At a market, fruit and vegetables are often priced by weight: sekilo is a kilo, setengah kilo half a kilo. Bu is short for Ibu.",
      "audio": "audio/id/sentences/s-35.mp3",
      "tags": [
        "market",
        "prices"
      ],
      "difficulty": 2
    },
    {
      "id": "s-36",
      "indonesian": "Bisa tolong tulis harganya?",
