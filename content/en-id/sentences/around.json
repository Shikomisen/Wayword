      "chunks": [
        {
          "t": "Teh ",
          "w": "w-teh"
        },
        {
          "t": "panas, ",
          "w": "w-panas"
        },
        {
          "t": "tidak pakai ",
          "w": "w-tidak"
        },
        {
          "t": "gula, ",
          "w": "w-gula"
        },
        {
          "t": "ya."
        }
      ],
      "cultureNote": "Tea and coffee come sweet unless you say otherwise. Unsweetened tea also has its own name: teh tawar.",
      "audio": "audio/id/sentences/s-32.mp3",
      "tags": [
        "food",
        "ordering"
      ],
      "difficulty": 2
    },
    {
      "id": "s-33",
      "indonesian": "Ayam ini pedas atau tidak?",
