      "chunks": [
        {
          "t": "Ayam ",
          "w": "w-ayam"
        },
        {
          "t": "ini ",
          "w": "w-ini"
        },
        {
          "t": "pedas ",
          "w": "w-pedas"
        },
        {
          "t": "atau tidak?",
          "w": "w-tidak"
        }
      ],
      "registerNotes": "Atau tidak? (or not?) on the end makes a plain yes-or-no question. Friends say atau nggak?",
      "audio": "audio/id/sentences/s-33.mp3",
      "tags": [
        "food",
