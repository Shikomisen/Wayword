      "chunks": [
        {
          "t": "Bisa ",
          "w": "w-bisa"
        },
        {
          "t": "tolong tulis "
        },
        {
          "t": "harganya?",
          "w": "w-harga"
        }
      ],
      "registerNotes": "Handy when the numbers go by too fast. Many stallholders will tap the price into a calculator or a phone instead.",
      "audio": "audio/id/sentences/s-36.mp3",
      "tags": [
        "market",
        "requests"
      ],
      "difficulty": 2
    },
    {
      "id": "s-37",
      "indonesian": "Sepatu ini terlalu kecil untuk saya.",
