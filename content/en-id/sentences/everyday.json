        "family",
        "numbers"
      ],
      "difficulty": 1
    },
    {
      "id": "s-09",
      "indonesian": "Kakak saya kerja di toko.",
      "english": "My older sister works in a shop.",
      "chunks": [
        {
          "t": "Kakak ",
          "w": "w-kakak"
        },
        {
          "t": "saya ",
          "w": "w-saya"
        },
        {
          "t": "kerja ",
          "w": "w-kerja"
        },
        {
          "t": "di toko.",
          "w": "w-toko"
        }
      ],
      "pitfallNote": "Kakak is an older brother or sister: Indonesian marks age, not sex. And there's no 'a' before toko.",
      "audio": "audio/id/sentences/s-09.mp3",
      "tags": [
        "family",
        "work"
      ],
      "difficulty": 2
    },
    {
      "id": "s-10",
      "indonesian": "Besok saya tidak kerja.",
      "english": "I'm not working tomorrow.",
      "chunks": [
        {
          "t": "Besok ",
          "w": "w-besok"
        },
        {
          "t": "saya ",
          "w": "w-saya"
        },
        {
          "t": "tidak ",
          "w": "w-tidak"
        },
        {
          "t": "kerja.",
          "w": "w-kerja"
        }
      ],
      "registerNotes": "Besok at the start sets the time, so the verb doesn't change. Tidak goes right before the verb it cancels.",
      "audio": "audio/id/sentences/s-10.mp3",
      "tags": [
        "time",
        "work"
      ],
      "difficulty": 1
    },
    {
      "id": "s-11",
      "indonesian": "HP saya di mana?",
      "english": "Where's my phone?",
      "chunks": [
        {
          "t": "HP ",
          "w": "w-hp"
        },
        {
          "t": "saya ",
          "w": "w-saya"
        },
        {
          "t": "di mana?",
          "w": "w-di-mana"
        }
      ],
      "registerNotes": "HP, said 'ha-pe', is the everyday word for a mobile. The same pattern finds anything: Kunci saya di mana? (Where are my keys?)",
