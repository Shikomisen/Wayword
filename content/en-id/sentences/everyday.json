      "difficulty": 2
    },
    {
      "id": "s-15",
      "indonesian": "Suami saya pulang jam enam.",
      "english": "My husband gets home at six.",
      "chunks": [
        {
          "t": "Suami ",
          "w": "w-suami"
        },
        {
          "t": "saya ",
          "w": "w-saya"
        },
        {
          "t": "pulang ",
          "w": "w-pulang"
        },
        {
          "t": "jam enam.",
          "w": "w-jam"
        }
      ],
      "pitfallNote": "Jam enam is six o'clock, but enam jam would be six hours. There's no need for a word for 'at'.",
