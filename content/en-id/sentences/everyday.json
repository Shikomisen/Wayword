      "tags": [
        "questions",
        "people"
      ],
      "difficulty": 2
    },
    {
      "id": "s-13",
      "indonesian": "Mereka belum datang.",
      "english": "They haven't arrived yet.",
      "chunks": [
        {
          "t": "Mereka ",
          "w": "w-mereka"
        },
        {
          "t": "belum ",
          "w": "w-belum"
        },
        {
          "t": "datang.",
          "w": "w-datang"
        }
      ],
      "pitfallNote": "Belum is 'not yet': it expects the thing to happen. Mereka tidak datang would mean they're not coming at all.",
      "audio": "audio/id/sentences/s-13.mp3",
