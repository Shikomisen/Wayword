      "chunks": [
        {
          "t": "Saya ",
          "w": "w-saya"
        },
        {
          "t": "tidak ",
          "w": "w-tidak"
        },
        {
          "t": "suka ",
          "w": "w-suka"
        },
        {
          "t": "bangun ",
