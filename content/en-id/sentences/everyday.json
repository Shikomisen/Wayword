      "audioHint": "Ha pe saya di mana?",
      "tags": [
        "things",
        "questions"
      ],
      "difficulty": 1
    },
    {
      "id": "s-12",
      "indonesian": "Bapak itu siapa?",
      "english": "Who's that man?",
      "chunks": [
        {
          "t": "Bapak ",
          "w": "w-bapak"
        },
        {
          "t": "itu ",
          "w": "w-itu"
        },
        {
          "t": "siapa?",
          "w": "w-siapa"
        }
      ],
      "pitfallNote": "Itu after a noun points: bapak itu, that man. Before it, itu makes a sentence: Itu bapak saya (That's my father).",
