    {
      "id": "s-17",
      "indonesian": "Saya mau ke pasar.",
      "japanese": "市場に行きます。",
      "chunks": [
        {
          "t": "Saya ",
          "w": "w-saya"
        },
        {
          "t": "mau ",
          "w": "w-mau"
        },
        {
          "t": "ke pasar.",
          "w": "w-pasar"
        }
      ],
      "pitfallNote": "「行く」にあたる動詞は要りません：mau ke で「（場所）に行く」。ke は向かう先の「〜へ」、di はいる場所の「〜に・で」です。",
      "audio": "audio/id/sentences/s-17.mp3",
      "tags": [
        "用事",
        "場所"
      ],
      "difficulty": 1
    },
    {
      "id": "s-18",
      "indonesian": "Stasiunnya jauh dari sini?",
      "japanese": "駅はここから遠いですか？",
