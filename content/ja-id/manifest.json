  "lessonGroups": [
    {
      "id": "sentence",
      "title": "文の組み立て",
      "description": "「〜です」がいらないこと、ini と itu、代名詞、持ち主の言い方、名詞が先で形容詞が後。"
    },
    {
      "id": "asking",
      "title": "質問と否定",
      "description": "tidak と bukan、疑問詞、はい・いいえで答える質問、ada と punya。"
    },
    {
      "id": "verbs",
      "title": "動詞と時",
      "description": "形の変わらない動詞、mau と bisa、時制のかわりの時の言葉、「〜へ」と「〜から」、数え方、ていねいな頼み方。"
    },
    {
      "id": "chain",
      "title": "「そして」「それから」",
      "description": "動作をつなぐ、付け加える。"
    },
    {
      "id": "reason",
      "title": "「〜から」「だから」",
      "description": "理由を言う。そして、そこから何が言えるかを言う。"
    },
    {
      "id": "contrast",
      "title": "「でも」",
      "description": "反対のことや、予想外のことを言う。"
    },
    {
      "id": "when",
      "title": "「もし」「〜時」「前」「後」",
      "description": "条件と、物事が起こる順番。"
    },
    {
      "id": "purpose",
      "title": "「〜ながら」「〜ように」",
      "description": "二つのことを同時にする。何のためかを言う。"
    },
    {
      "id": "affixes",
      "title": "接頭辞・接尾辞",
      "description": "ber-, me-, di-, -kan, -i, ter-, ke-…-an が語根をどう変えるか。書き言葉が話し言葉より長く見える理由。"
    },
    {
      "id": "describe",
      "title": "比べる・説明する",
      "description": "動詞から作る名詞、「〜と同じくらい」、「もっと」と「いちばん」、yang、言葉のくり返し。"
    },
    {
      "id": "conversation",
      "title": "本当の会話の言葉",
      "description": "-nya、pernah、masih と lagi、kok・sih・dong・deh・kan、人の話を伝える、推測する、ていねいに頼む。"
    }
  ],
