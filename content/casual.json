{
  "schemaVersion": 1,
  "id": "casual",
  "title": "Casual Speech",
  "order": 11,
  "description": "How you actually talk with a partner, friends and family — each one next to its polite version, so you always know which to use with whom.",
  "phrases": [
    { "id": "cas-01", "register": "casual", "japanese": "うん", "furigana": "うん", "romaji": "un", "english": "Yeah. / Yes.",
      "polite": { "japanese": "はい", "furigana": "はい", "romaji": "hai", "audio": "audio/ja/casual/cas-01-polite.mp3" },
      "registerNotes": "The everyday yes with anyone you're close to — your partner, friends, family. はい to your partner sounds stiff, like answering a teacher.",
      "audio": "audio/ja/casual/cas-01.mp3", "tags": ["yes-no", "essential"], "difficulty": 1 },
    { "id": "cas-02", "register": "casual", "japanese": "ううん", "furigana": "ううん", "romaji": "uun", "english": "No. / Nope.",
      "polite": { "japanese": "いいえ", "furigana": "いいえ", "romaji": "iie", "audio": "audio/ja/casual/cas-02-polite.mp3" },
      "registerNotes": "Two beats with a falling pitch, often with a small head shake — don't confuse it with うん. In polite speech いいえ is always safe.",
      "audio": "audio/ja/casual/cas-02.mp3", "tags": ["yes-no", "essential"], "difficulty": 1 },
    { "id": "cas-03", "register": "casual", "japanese": "ありがとう", "furigana": "ありがとう", "romaji": "arigatō", "english": "Thanks.",
      "polite": { "japanese": "ありがとうございます", "furigana": "ありがとうございます", "romaji": "arigatō gozaimasu", "audio": "audio/ja/casual/cas-03-polite.mp3" },
      "registerNotes": "Dropping ございます is right with your partner and friends. Keep it for staff, strangers and your partner's family until they tell you to relax.",
      "audio": "audio/ja/casual/cas-03.mp3", "tags": ["thanks", "essential"], "difficulty": 1 },
    { "id": "cas-04", "register": "casual", "japanese": "ごめん", "furigana": "ごめん", "romaji": "gomen", "english": "Sorry.",
      "polite": { "japanese": "すみません", "furigana": "すみません", "romaji": "sumimasen", "audio": "audio/ja/casual/cas-04-polite.mp3" },
      "registerNotes": "For small things with people you're close to; ごめんね is softer and warmer. With strangers and staff it's すみません.",
      "audio": "audio/ja/casual/cas-04.mp3", "tags": ["apology", "essential"], "difficulty": 1 },
    { "id": "cas-05", "register": "casual", "japanese": "おはよう", "furigana": "おはよう", "romaji": "ohayō", "english": "Morning!",
      "polite": { "japanese": "おはようございます", "furigana": "おはようございます", "romaji": "ohayō gozaimasu", "audio": "audio/ja/casual/cas-05-polite.mp3" },
      "registerNotes": "What you say to your partner when you wake up. ございます is for neighbours, colleagues and anyone older.",
      "audio": "audio/ja/casual/cas-05.mp3", "tags": ["greeting", "home"], "difficulty": 1 },
    { "id": "cas-06", "register": "casual", "japanese": "おやすみ", "furigana": "おやすみ", "romaji": "oyasumi", "english": "Night! / Sleep well.",
      "polite": { "japanese": "おやすみなさい", "furigana": "おやすみなさい", "romaji": "oyasuminasai", "audio": "audio/ja/casual/cas-06-polite.mp3" },
      "registerNotes": "The last thing said at night at home. Plenty of couples say おやすみなさい too — it sounds warm, not stiff.",
      "audio": "audio/ja/casual/cas-06.mp3", "tags": ["greeting", "home"], "difficulty": 1 },
    { "id": "cas-07", "register": "casual", "japanese": "大丈夫？", "furigana": "{大丈夫|だいじょうぶ}？", "romaji": "daijōbu?", "english": "Are you okay?",
      "polite": { "japanese": "大丈夫ですか？", "furigana": "{大丈夫|だいじょうぶ}ですか？", "romaji": "daijōbu desu ka?", "audio": "audio/ja/casual/cas-07-polite.mp3" },
      "registerNotes": "With a rising tone it asks; said flat, 大丈夫 answers 'I'm fine'. It's also the go-to way to say 'no thanks'.",
      "audio": "audio/ja/casual/cas-07.mp3", "tags": ["care", "essential"], "difficulty": 1 },
    { "id": "cas-08", "register": "casual", "japanese": "分かった", "furigana": "{分|わ}かった", "romaji": "wakatta", "english": "Got it. / Okay.",
      "polite": { "japanese": "分かりました", "furigana": "{分|わ}かりました", "romaji": "wakarimashita", "audio": "audio/ja/casual/cas-08-polite.mp3" },
      "registerNotes": "The plain past is the casual version of almost every verb: 分かりました → 分かった.",
      "audio": "audio/ja/casual/cas-08.mp3", "tags": ["reply", "essential"], "difficulty": 1 },
    { "id": "cas-09", "register": "casual", "japanese": "知らない", "furigana": "{知|し}らない", "romaji": "shiranai", "english": "I don't know.",
      "polite": { "japanese": "知りません", "furigana": "{知|し}りません", "romaji": "shirimasen", "audio": "audio/ja/casual/cas-09-polite.mp3" },
      "registerNotes": "Plain negative: ません becomes ない. A flat 知らない can sound like 'no idea, not my problem' — 分からない ('I'm not sure') is gentler.",
      "audio": "audio/ja/casual/cas-09.mp3", "tags": ["reply"], "difficulty": 2 },
    { "id": "cas-10", "register": "casual", "japanese": "いいよ", "furigana": "いいよ", "romaji": "ii yo", "english": "Sure. / That's fine.",
      "polite": { "japanese": "いいですよ", "furigana": "いいですよ", "romaji": "ii desu yo", "audio": "audio/ja/casual/cas-10-polite.mp3" },
      "registerNotes": "Agreeing to a request; よ adds friendliness. Careful: いい on its own can mean 'no thanks, I'm good' — tone decides.",
      "audio": "audio/ja/casual/cas-10.mp3", "tags": ["reply", "essential"], "difficulty": 1 },
    { "id": "cas-11", "register": "casual", "japanese": "ちょっと待って", "furigana": "ちょっと{待|ま}って", "romaji": "chotto matte", "english": "Wait a sec.",
      "polite": { "japanese": "ちょっと待ってください", "furigana": "ちょっと{待|ま}ってください", "romaji": "chotto matte kudasai", "audio": "audio/ja/casual/cas-11-polite.mp3" },
      "registerNotes": "Dropping ください from a て-form request is the standard casual request: 待ってください → 待って.",
      "audio": "audio/ja/casual/cas-11.mp3", "tags": ["request", "essential"], "difficulty": 1 },
    { "id": "cas-12", "register": "casual", "japanese": "何してるの？", "furigana": "{何|なに}してるの？", "romaji": "nani shiteru no?", "english": "What are you doing?",
      "polite": { "japanese": "何をしているんですか？", "furigana": "{何|なに}をしているんですか？", "romaji": "nani o shite iru n desu ka?", "audio": "audio/ja/casual/cas-12-polite.mp3" },
      "registerNotes": "Casual speech drops を and squeezes している into してる. The の at the end makes the question softer and more personal.",
      "audio": "audio/ja/casual/cas-12.mp3", "tags": ["question", "home"], "difficulty": 2 },
    { "id": "cas-13", "register": "casual", "japanese": "どこ行くの？", "furigana": "どこ{行|い}くの？", "romaji": "doko iku no?", "english": "Where are you going?",
      "polite": { "japanese": "どこに行くんですか？", "furigana": "どこに{行|い}くんですか？", "romaji": "doko ni iku n desu ka?", "audio": "audio/ja/casual/cas-13-polite.mp3" },
      "registerNotes": "Particles like に drop out of casual questions; rising intonation does the asking.",
      "audio": "audio/ja/casual/cas-13.mp3", "tags": ["question"], "difficulty": 2 },
    { "id": "cas-14", "register": "casual", "japanese": "お腹すいた", "furigana": "お{腹|なか}すいた", "romaji": "onaka suita", "english": "I'm hungry.",
      "polite": { "japanese": "お腹がすきました", "furigana": "お{腹|なか}がすきました", "romaji": "onaka ga sukimashita", "audio": "audio/ja/casual/cas-14-polite.mp3" },
      "registerNotes": "が is routinely dropped in casual speech. One of the most-said sentences in any Japanese home.",
      "audio": "audio/ja/casual/cas-14.mp3", "tags": ["feelings", "home"], "difficulty": 1 },
    { "id": "cas-15", "register": "casual", "japanese": "疲れた", "furigana": "{疲|つか}れた", "romaji": "tsukareta", "english": "I'm tired.",
      "polite": { "japanese": "疲れました", "furigana": "{疲|つか}れました", "romaji": "tsukaremashita", "audio": "audio/ja/casual/cas-15-polite.mp3" },
      "registerNotes": "Past tense, because you have *become* tired. At home it usually comes with a long sigh: 疲れたー.",
      "audio": "audio/ja/casual/cas-15.mp3", "tags": ["feelings", "home"], "difficulty": 1 },
    { "id": "cas-16", "register": "casual", "japanese": "眠い", "furigana": "{眠|ねむ}い", "romaji": "nemui", "english": "I'm sleepy.",
      "polite": { "japanese": "眠いです", "furigana": "{眠|ねむ}いです", "romaji": "nemui desu", "audio": "audio/ja/casual/cas-16-polite.mp3" },
      "registerNotes": "い-adjectives go casual just by dropping です.",
      "audio": "audio/ja/casual/cas-16.mp3", "tags": ["feelings", "home"], "difficulty": 1 },
    { "id": "cas-17", "register": "casual", "japanese": "美味しい！", "furigana": "{美味|おい}しい！", "romaji": "oishii!", "english": "This is so good!",
      "polite": { "japanese": "美味しいです", "furigana": "{美味|おい}しいです", "romaji": "oishii desu", "audio": "audio/ja/casual/cas-17-polite.mp3" },
      "registerNotes": "Say it about food your partner cooks — often, and with feeling. うまい is a rougher, mostly male version.",
      "audio": "audio/ja/casual/cas-17.mp3", "tags": ["food", "reaction"], "difficulty": 1 },
    { "id": "cas-18", "register": "casual", "japanese": "楽しかった", "furigana": "{楽|たの}しかった", "romaji": "tanoshikatta", "english": "That was fun.",
      "polite": { "japanese": "楽しかったです", "furigana": "{楽|たの}しかったです", "romaji": "tanoshikatta desu", "audio": "audio/ja/casual/cas-18-polite.mp3" },
      "registerNotes": "Past of an い-adjective: 楽しい → 楽しかった. A good thing to say at the end of a day out.",
      "audio": "audio/ja/casual/cas-18.mp3", "tags": ["feelings", "reaction"], "difficulty": 2 },
    { "id": "cas-19", "register": "casual", "japanese": "ほんと？", "furigana": "ほんと？", "romaji": "honto?", "english": "Really?",
      "polite": { "japanese": "本当ですか？", "furigana": "{本当|ほんとう}ですか？", "romaji": "hontō desu ka?", "audio": "audio/ja/casual/cas-19-polite.mp3" },
      "registerNotes": "In speech the う of 本当 usually disappears. Rising tone for surprise; a flat ほんとだ means 'oh, it's true'.",
      "audio": "audio/ja/casual/cas-19.mp3", "tags": ["reaction", "essential"], "difficulty": 1 },
    { "id": "cas-20", "register": "casual", "japanese": "そうだね", "furigana": "そうだね", "romaji": "sō da ne", "english": "Yeah, that's true.",
      "polite": { "japanese": "そうですね", "furigana": "そうですね", "romaji": "sō desu ne", "audio": "audio/ja/casual/cas-20-polite.mp3" },
      "registerNotes": "Agreeing and keeping the conversation going. The polite そうですね doubles as a thinking filler: 'hmm, let me see…'.",
      "audio": "audio/ja/casual/cas-20.mp3", "tags": ["reply", "essential"], "difficulty": 1 },
    { "id": "cas-21", "register": "casual", "japanese": "何食べたい？", "furigana": "{何|なに}{食|た}べたい？", "romaji": "nani tabetai?", "english": "What do you want to eat?",
      "polite": { "japanese": "何が食べたいですか？", "furigana": "{何|なに}が{食|た}べたいですか？", "romaji": "nani ga tabetai desu ka?", "audio": "audio/ja/casual/cas-21-polite.mp3" },
      "registerNotes": "〜たい means 'want to'. The casual question drops が and ですか and lets the rising tone ask.",
      "audio": "audio/ja/casual/cas-21.mp3", "tags": ["food", "question", "home"], "difficulty": 2 },
    { "id": "cas-22", "register": "casual", "japanese": "一緒に行こう", "furigana": "{一緒|いっしょ}に{行|い}こう", "romaji": "issho ni ikō", "english": "Let's go together.",
      "polite": { "japanese": "一緒に行きましょう", "furigana": "{一緒|いっしょ}に{行|い}きましょう", "romaji": "issho ni ikimashō", "audio": "audio/ja/casual/cas-22-polite.mp3" },
      "registerNotes": "〜ましょう becomes the volitional 〜おう/〜よう: 行きましょう → 行こう, 食べましょう → 食べよう.",
      "audio": "audio/ja/casual/cas-22.mp3", "tags": ["suggestion"], "difficulty": 2 },
    { "id": "cas-23", "register": "casual", "japanese": "手伝おうか？", "furigana": "{手伝|てつだ}おうか？", "romaji": "tetsudaō ka?", "english": "Want me to help?",
      "polite": { "japanese": "手伝いましょうか？", "furigana": "{手伝|てつだ}いましょうか？", "romaji": "tetsudaimashō ka?", "audio": "audio/ja/casual/cas-23-polite.mp3" },
      "registerNotes": "Volitional + か offers to do something: 'shall I…?'. Very handy around the house.",
      "audio": "audio/ja/casual/cas-23.mp3", "tags": ["offer", "home"], "difficulty": 2 },
    { "id": "cas-24", "register": "casual", "japanese": "気をつけてね", "furigana": "{気|き}をつけてね", "romaji": "ki o tsukete ne", "english": "Take care. / Be careful.",
      "polite": { "japanese": "気をつけてください", "furigana": "{気|き}をつけてください", "romaji": "ki o tsukete kudasai", "audio": "audio/ja/casual/cas-24-polite.mp3" },
      "registerNotes": "Said to someone heading out. The ね makes it warm.",
      "audio": "audio/ja/casual/cas-24.mp3", "tags": ["care", "home"], "difficulty": 1 },
    { "id": "cas-25", "register": "casual", "japanese": "またね", "furigana": "またね", "romaji": "mata ne", "english": "See you.",
      "polite": { "japanese": "では、また", "furigana": "では、また", "romaji": "dewa, mata", "audio": "audio/ja/casual/cas-25-polite.mp3" },
      "registerNotes": "またね, じゃあね and バイバイ are the friend-and-family goodbyes. With anyone you'd use です/ます with: では、また, or 失礼します when leaving a room.",
      "audio": "audio/ja/casual/cas-25.mp3", "tags": ["greeting"], "difficulty": 1 },
    { "id": "cas-26", "register": "casual", "japanese": "おかえり", "furigana": "おかえり", "romaji": "okaeri", "english": "Welcome home.",
      "polite": { "japanese": "おかえりなさい", "furigana": "おかえりなさい", "romaji": "okaerinasai", "audio": "audio/ja/casual/cas-26-polite.mp3" },
      "registerNotes": "Said to whoever walks in the door; the answer is ただいま. Families use both — なさい is a little warmer and more careful.",
      "audio": "audio/ja/casual/cas-26.mp3", "tags": ["home"], "difficulty": 1 },
    { "id": "cas-27", "register": "casual", "japanese": "ただいま", "furigana": "ただいま", "romaji": "tadaima", "english": "I'm home.",
      "polite": { "japanese": "ただいま戻りました", "furigana": "ただいま{戻|もど}りました", "romaji": "tadaima modorimashita", "audio": "audio/ja/casual/cas-27-polite.mp3" },
      "registerNotes": "Said every time you come home. The polite version is what you'd say walking back into the office.",
      "audio": "audio/ja/casual/cas-27.mp3", "tags": ["home"], "difficulty": 1 },
    { "id": "cas-28", "register": "casual", "japanese": "行ってくるね", "furigana": "{行|い}ってくるね", "romaji": "itte kuru ne", "english": "I'm heading out — see you later.",
      "polite": { "japanese": "行ってきます", "furigana": "{行|い}ってきます", "romaji": "itte kimasu", "audio": "audio/ja/casual/cas-28-polite.mp3" },
      "registerNotes": "The set phrase 行ってきます works everywhere, home included. 行ってくるね is the softer, more casual version partners use.",
      "audio": "audio/ja/casual/cas-28.mp3", "tags": ["home"], "difficulty": 2 },
    { "id": "cas-29", "register": "casual", "japanese": "好き", "furigana": "{好|す}き", "romaji": "suki", "english": "I like it. / I like you.",
      "polite": { "japanese": "好きです", "furigana": "{好|す}きです", "romaji": "suki desu", "audio": "audio/ja/casual/cas-29-polite.mp3" },
      "registerNotes": "Said to a person, 好き is the everyday 'I love you'. 大好き is stronger; 愛してる is rare and heavy — save it.",
      "audio": "audio/ja/casual/cas-29.mp3", "tags": ["feelings"], "difficulty": 1 },
    { "id": "cas-30", "register": "casual", "japanese": "会いたい", "furigana": "{会|あ}いたい", "romaji": "aitai", "english": "I miss you.",
      "polite": { "japanese": "会いたいです", "furigana": "{会|あ}いたいです", "romaji": "aitai desu", "audio": "audio/ja/casual/cas-30-polite.mp3" },
      "registerNotes": "Literally 'I want to see you' — Japanese's way of saying 'I miss you'. The classic message to a partner when you're apart.",
      "audio": "audio/ja/casual/cas-30.mp3", "tags": ["feelings"], "difficulty": 2 },
    { "id": "cas-31", "register": "casual", "japanese": "どうしたの？", "furigana": "どうしたの？", "romaji": "dō shita no?", "english": "What's wrong? / What happened?",
      "polite": { "japanese": "どうしましたか？", "furigana": "どうしましたか？", "romaji": "dō shimashita ka?", "audio": "audio/ja/casual/cas-31-polite.mp3" },
      "registerNotes": "Asking when someone seems upset or something has happened. The の makes it gentle and caring.",
      "audio": "audio/ja/casual/cas-31.mp3", "tags": ["care", "question"], "difficulty": 2 },
    { "id": "cas-32", "register": "casual", "japanese": "寒くない？", "furigana": "{寒|さむ}くない？", "romaji": "samukunai?", "english": "Aren't you cold?",
      "polite": { "japanese": "寒くないですか？", "furigana": "{寒|さむ}くないですか？", "romaji": "samukunai desu ka?", "audio": "audio/ja/casual/cas-32-polite.mp3" },
      "registerNotes": "Asking with a negative is a natural, caring way to check — like 'you're not cold?'.",
      "audio": "audio/ja/casual/cas-32.mp3", "tags": ["care", "question"], "difficulty": 2 },
    { "id": "cas-33", "register": "casual", "japanese": "先に寝るね", "furigana": "{先|さき}に{寝|ね}るね", "romaji": "saki ni neru ne", "english": "I'm going to bed (before you).",
      "polite": { "japanese": "先に寝ます", "furigana": "{先|さき}に{寝|ね}ます", "romaji": "saki ni nemasu", "audio": "audio/ja/casual/cas-33-polite.mp3" },
      "registerNotes": "先に means 'ahead of you'. The ね lets them know rather than announcing it.",
      "audio": "audio/ja/casual/cas-33.mp3", "tags": ["home"], "difficulty": 2 },
    { "id": "cas-34", "register": "casual", "japanese": "何時に帰る？", "furigana": "{何時|なんじ}に{帰|かえ}る？", "romaji": "nanji ni kaeru?", "english": "What time will you be home?",
      "polite": { "japanese": "何時に帰りますか？", "furigana": "{何時|なんじ}に{帰|かえ}りますか？", "romaji": "nanji ni kaerimasu ka?", "audio": "audio/ja/casual/cas-34-polite.mp3" },
      "registerNotes": "Casual questions are often just the plain form with a rising tone.",
      "audio": "audio/ja/casual/cas-34.mp3", "tags": ["question", "home", "time"], "difficulty": 2 },
    { "id": "cas-35", "register": "casual", "japanese": "手伝って", "furigana": "{手伝|てつだ}って", "romaji": "tetsudatte", "english": "Help me out?",
      "polite": { "japanese": "手伝ってください", "furigana": "{手伝|てつだ}ってください", "romaji": "tetsudatte kudasai", "audio": "audio/ja/casual/cas-35-polite.mp3" },
      "registerNotes": "A plain て-form request. Put ちょっと in front to soften it: ちょっと手伝って.",
      "audio": "audio/ja/casual/cas-35.mp3", "tags": ["request", "home"], "difficulty": 1 },
    { "id": "cas-36", "register": "casual", "japanese": "いいね！", "furigana": "いいね！", "romaji": "ii ne!", "english": "Nice! / Sounds good.",
      "polite": { "japanese": "いいですね", "furigana": "いいですね", "romaji": "ii desu ne", "audio": "audio/ja/casual/cas-36-polite.mp3" },
      "registerNotes": "Reacting to a plan or a photo. いいね is also the Japanese 'like' button.",
      "audio": "audio/ja/casual/cas-36.mp3", "tags": ["reaction", "essential"], "difficulty": 1 },
    { "id": "cas-37", "register": "casual", "japanese": "すごい！", "furigana": "すごい！", "romaji": "sugoi!", "english": "Wow! / Amazing!",
      "polite": { "japanese": "すごいですね", "furigana": "すごいですね", "romaji": "sugoi desu ne", "audio": "audio/ja/casual/cas-37-polite.mp3" },
      "registerNotes": "An endlessly useful reaction. In casual speech it's often stretched: すごーい.",
      "audio": "audio/ja/casual/cas-37.mp3", "tags": ["reaction"], "difficulty": 1 },
    { "id": "cas-38", "register": "casual", "japanese": "ほんとにごめん", "furigana": "ほんとにごめん", "romaji": "honto ni gomen", "english": "I'm really sorry.",
      "polite": { "japanese": "本当に申し訳ありません", "furigana": "{本当|ほんとう}に{申|もう}し{訳|わけ}ありません", "romaji": "hontō ni mōshiwake arimasen", "audio": "audio/ja/casual/cas-38-polite.mp3" },
      "registerNotes": "A real apology to someone close. The polite version is the serious, formal apology — and the one to use with your partner's parents if something goes wrong.",
      "audio": "audio/ja/casual/cas-38.mp3", "tags": ["apology"], "difficulty": 3 },
    { "id": "cas-39", "register": "casual", "japanese": "ねえ", "furigana": "ねえ", "romaji": "nē", "english": "Hey… (getting attention)",
      "polite": { "japanese": "すみません", "furigana": "すみません", "romaji": "sumimasen", "audio": "audio/ja/casual/cas-39-polite.mp3" },
