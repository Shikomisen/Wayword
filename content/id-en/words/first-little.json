{
  "schemaVersion": 1,
  "id": "words-first-little",
  "title": "Kata kecil",
  "description": "Kata pendek seperti I, you, this, dan what yang wajib ada untuk membuat kalimat.",
  "items": [
    {
      "id": "w-i",
      "english": "I",
      "indonesian": "saya, aku",
      "pos": "pronoun",
      "registerNotes": "Satu kata untuk saya dan aku. Selalu ditulis dengan huruf besar I, di mana pun letaknya dalam kalimat.",
      "audio": "audio/en/words/w-i.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1
    },
    {
      "id": "w-you",
      "english": "you",
      "indonesian": "kamu, Anda, kalian",
      "pos": "pronoun",
      "registerNotes": "Satu kata untuk kamu, Anda, dan kalian: sopan atau akrab, satu orang atau banyak.",
      "audio": "audio/en/words/w-you.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1
    },
    {
      "id": "w-he",
      "english": "he",
      "indonesian": "dia (laki-laki)",
      "pos": "pronoun",
      "pitfallNote": "Bahasa Indonesia hanya punya dia, jadi he dan she sering tertukar. Laki-laki: he (dan his). Perempuan: she (dan her).",
      "audio": "audio/en/words/w-he.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1
    },
    {
      "id": "w-she",
      "english": "she",
      "indonesian": "dia (perempuan)",
      "pos": "pronoun",
      "pitfallNote": "Jangan tertukar dengan he: dia yang perempuan selalu she, dan miliknya her, bukan his: She lost her bag.",
      "audio": "audio/en/words/w-she.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1
    },
    {
      "id": "w-it",
      "english": "it",
      "indonesian": "itu, ia (benda, hewan)",
      "pos": "pronoun",
      "registerNotes": "Juga jadi subjek kalimat tentang cuaca, waktu, dan jarak: It’s hot. (Panas.), It’s ten o’clock. (Jam sepuluh.) Subjeknya tidak boleh hilang: bukan Is hot.",
      "audio": "audio/en/words/w-it.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1
    },
    {
      "id": "w-we",
      "english": "we",
      "indonesian": "kami, kita",
      "pos": "pronoun",
      "audio": "audio/en/words/w-we.mp3",
      "tags": [
        "kata kecil"
      ],
      "difficulty": 1,
      "registerNotes": "Satu kata untuk kami dan kita."
    },
    {
