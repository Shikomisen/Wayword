  "lessonGroups": [
    {
      "id": "first-sentence",
      "title": "Dasar kalimat",
      "description": "to be, this dan that, a dan the, bentuk jamak, my dan your, there is, kata depan untuk tempat dan waktu. Kerangka kalimat bahasa Inggris."
    },
    {
      "id": "first-verbs",
      "title": "Dasar kata kerja",
      "description": "Present tense, bentuk negatif, can, -ing, past tense, bentuk pertanyaan. Cara memakai kata kerja untuk bercerita tentang hal sehari-hari."
    },
    {
      "id": "ask",
      "title": "Meminta",
      "description": "Pola untuk memesan dan meminta sesuatu. Ganti bagian ○○, dan kamu bisa memakainya di banyak situasi."
    },
    {
      "id": "question",
      "title": "Bertanya",
      "description": "Pola untuk bertanya: ada? apakah ini…? di mana? berapa harganya?"
    },
    {
      "id": "polite",
      "title": "Meminta & menolak dengan sopan",
      "description": "Meminta orang melakukan sesuatu, minta izin, menolak dengan halus. Cara membuat kalimat yang sopan ala bahasa Inggris."
    },
    {
      "id": "link",
      "title": "Kata penghubung",
      "description": "Kata seperti so, but, dan because yang menghubungkan kalimat. Dengan kata-kata ini, kamu juga bisa menyampaikan alasan dan perasaan."
    },
    {
      "id": "order",
      "title": "Urutan kata & bentuk tanya",
      "description": "Bagian yang berbeda dari bahasa Indonesia. Urutan kata ala bahasa Inggris, serta bentuk pertanyaan dan jawabannya."
    },
    {
      "id": "tenses",
      "title": "Tenses: pengalaman, rencana, masa lalu",
      "description": "have been, will dan going to, used to. Bahasa Indonesia cukup memakai sudah, akan, atau dulu; bahasa Inggris mengubah bentuk kata kerjanya."
    },
    {
      "id": "modals",
      "title": "Modal: saran, kewajiban, kemungkinan",
      "description": "should, have to, might. 'Sebaiknya…', 'harus…', 'mungkin…'."
    },
    {
      "id": "conditionals",
      "title": "Kalau & seandainya",
      "description": "if dan wish. 'Kalau' untuk hal yang mungkin terjadi, dan 'seandainya' untuk hal yang berbeda dari kenyataan."
    },
    {
      "id": "structures",
      "title": "Menyusun kalimat",
      "description": "Membandingkan, terlalu…, -ing dan to, menjelaskan kata benda, kalimat pasif, menyuruh dan membolehkan."
    },
    {
      "id": "conversation",
      "title": "Pola percakapan",
      "description": "Bertanya dengan sopan, menyampaikan perkataan orang, memberi usul, bilang 'aku juga'."
    }
  ],
