  "id": "con-demo",
  "connector": "でも",
  "gloss": "but (new sentence)",
  "title": "でも — but (new sentence)",
  "pattern": "A。でも、B。",
  "explanation": "でも starts a new sentence that goes against the last one: \"But…\". けど and が join two halves of one sentence; でも begins a fresh one. It’s also how you push back gently in conversation: でも、{高|たか}いよ — but it’s expensive.",
  "natural": "Everyday speech, casual and polite. Very common when replying: でも… (yes, but…).",
  "stiff": "Formal writing uses しかし instead. And starting every reply with でも makes you sound like you always disagree.",
  "examples": [
    {
      "id": "cx-demo-1",
      "japanese": "映画は長かった。でも、面白かった。",
      "furigana": "{映画|えいが}は{長|なが}かった。でも、{面白|おもしろ}かった。",
      "english": "The movie was long. But it was good.",
      "register": "casual",
      "chunks": [
        {
          "t": "{映画|えいが}は",
          "w": "w-eiga"
        },
        {
          "t": "{長|なが}かった。"
        },
        {
          "t": "でも、"
        },
        {
          "t": "{面白|おもしろ}かった。"
        }
      ],
      "gap": {
        "before": "{映画|えいが}は{長|なが}かった。",
        "answer": "でも",
        "after": "、{面白|おもしろ}かった。",
        "options": [
          "でも",
          "だから",
          "そして"
        ]
      },
