{
  "schemaVersion": 1,
  "id": "gr-ni",
  "connector": "に",
  "gloss": "at a time; to a place; in",
  "title": "に — at, to, in",
  "pattern": "time に / place に {行|い}く・{来|く}る・いる",
  "explanation": "に points at a spot: a time ({七時|しちじ}に{起|お}きます — I get up at seven), a place you go to ({駅|えき}に{行|い}きます — I’m going to the station), or where someone or something is ({家|いえ}にいます — I’m at home). It’s also who you meet or give something to: {友達|ともだち}に{会|あ}います.",
  "natural": "Words like {今日|きょう}, {明日|あした} and {毎日|まいにち} don’t take に: {明日|あした}{行|い}きます. Clock times, days of the week and dates do.",
  "stiff": "{明日|あした}に and {今|いま}に sound wrong. And for where an action happens (eating, working), use で, not に: that’s the next lesson.",
  "examples": [
    {
      "id": "gx-ni-1",
      "japanese": "毎日、七時に起きます。",
      "furigana": "{毎日|まいにち}、{七時|しちじ}に{起|お}きます。",
      "romaji": "mainichi, shichiji ni okimasu",
      "english": "I get up at seven every day.",
      "register": "polite",
      "chunks": [
        {
          "t": "{毎日|まいにち}、",
          "w": "w-mainichi"
        },
        {
          "t": "{七時|しちじ}に"
        },
        {
          "t": "{起|お}きます。",
          "w": "w-okiru"
        }
      ],
      "gap": {
        "before": "{毎日|まいにち}、{七時|しちじ}",
        "answer": "に",
        "after": "{起|お}きます。",
        "options": [
          "に",
          "で",
          "を"
        ],
        "why": "A clock time takes に."
      },
      "audio": "audio/ja/grammar/gx-ni-1.mp3",
      "tags": [
