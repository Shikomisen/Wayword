          "w": "w-senshuu"
        },
        {
          "t": "{旅行|りょこう}は",
          "w": "w-ryokou"
        },
        {
          "t": "{楽|たの}しかったです。",
          "w": "w-tanoshii"
        }
      ],
      "gap": {
        "before": "{先週|せんしゅう}の{旅行|りょこう}は{楽|たの}し",
        "answer": "かった",
        "after": "です。",
        "options": [
          "かった",
          "い",
          "くない"
        ],
        "why": "Was fun: 楽しい → 楽しかった."
