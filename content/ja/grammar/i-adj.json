{
  "schemaVersion": 1,
  "id": "gr-i-adj",
  "connector": "〜い",
  "gloss": "い-adjectives: big, cheap, fun",
  "title": "〜い — い-adjectives",
  "pattern": "〜いです / 〜くないです / 〜かったです",
  "explanation": "Most describing words end in い: {高|たか}い, {安|やす}い, {楽|たの}しい. They go before a noun ({高|たか}い{店|みせ}, an expensive shop) or at the end with です ({高|たか}いです, it’s expensive). They change their own ending: not, {高|たか}くないです; was, {高|たか}かったです; wasn’t, {高|たか}くなかったです. いい is the odd one out: よくないです, よかったです.",
  "natural": "In casual speech, drop です: この{店|みせ}、{高|たか}い！ — this place is pricey!",
  "stiff": "Don’t add じゃない or でした to an い-adjective: {高|たか}いじゃないです and {高|たか}いでした are wrong. The adjective changes itself: {高|たか}くないです, {高|たか}かったです.",
  "examples": [
    {
      "id": "gx-i-adj-1",
      "japanese": "先週の旅行は楽しかったです。",
      "furigana": "{先週|せんしゅう}の{旅行|りょこう}は{楽|たの}しかったです。",
      "romaji": "senshū no ryokō wa tanoshikatta desu",
      "english": "Last week’s trip was fun.",
      "register": "polite",
      "chunks": [
        {
