{
  "schemaVersion": 1,
  "id": "gr-ga-subject",
  "connector": "が",
  "gloss": "who or what (the subject)",
  "title": "が — who or what",
  "pattern": "subject が verb or adjective",
  "explanation": "が marks who or what does something, or is something: {雨|あめ}が{降|ふ}っています — it’s raining (rain is falling). It’s also the particle for what you like, understand, can do or have: コーヒーが{好|す}きです, {日本語|にほんご}が{分|わ}かります. And question words take が, never は: {誰|だれ}が{来|き}ますか — who’s coming?",
  "natural": "が is for new information, and for what you notice right now: あ、バスが{来|き}た！ — oh, the bus is here!",
  "stiff": "{誰|だれ}は and {何|なに}は are wrong: question words take が. And with {好|す}き, {分|わ}かる and ある, the thing takes が, not を.",
  "examples": [
    {
      "id": "gx-ga-subject-1",
      "japanese": "私はコーヒーが好きです。",
      "furigana": "{私|わたし}は{コーヒー|こーひー}が{好|す}きです。",
      "romaji": "watashi wa kōhī ga suki desu",
      "english": "I like coffee.",
      "register": "polite",
      "chunks": [
        {
          "t": "{私|わたし}は",
          "w": "w-watashi"
        },
        {
          "t": "{コーヒー|こーひー}が",
          "w": "w-koohii"
        },
        {
          "t": "{好|す}きです。",
          "w": "w-suki"
        }
      ],
      "gap": {
        "before": "{私|わたし}は{コーヒー|こーひー}",
        "answer": "が",
        "after": "{好|す}きです。",
        "options": [
          "が",
          "を",
          "に"
        ],
        "why": "With 好き, what you like takes が."
