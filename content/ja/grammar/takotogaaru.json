{
  "schemaVersion": 1,
  "id": "gr-takotogaaru",
  "connector": "〜たことがある",
  "gloss": "have done (ever)",
  "title": "〜たことがある — have you ever…?",
  "pattern": "verb た form + ことがある / ことがない",
  "explanation": "To talk about experience — have you ever, I’ve never — use the た form + ことがある: {日本|にほん}に{行|い}ったことがあります — I’ve been to Japan. Never is ことがない. Asking: {食|た}べたことがありますか — have you ever eaten it?",
  "natural": "A great conversation starter: {北海道|ほっかいどう}に{行|い}ったことある？ — have you ever been to Hokkaido?",
  "stiff": "Not for one recent event (“I went yesterday”): that’s just {行|い}きました. ことがある is about having the experience at all.",
  "examples": [
    {
      "id": "gx-takotogaaru-1",
      "japanese": "日本に行ったことがありますか。",
      "furigana": "{日本|にほん}に{行|い}ったことがありますか。",
      "english": "Have you ever been to Japan?",
      "register": "polite",
      "chunks": [
        {
          "t": "{日本|にほん}に",
          "w": "w-nihon"
        },
        {
          "t": "{行|い}ったことが",
          "w": "w-iku"
        },
        {
          "t": "ありますか。"
        }
      ],
      "gap": {
        "before": "{日本|にほん}に{行|い}った",
        "answer": "ことが",
        "after": "ありますか。",
        "options": [
          "ことが",
          "ものが",
          "ところが"
        ],
        "why": "Experience: た + ことがある."
      },
      "audio": "audio/ja/grammar/gx-takotogaaru-1.mp3",
      "tags": [
