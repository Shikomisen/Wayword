          "t": "{料理|りょうり}を",
          "w": "w-ryouri"
        },
        {
          "t": "しています。",
          "w": "w-suru"
        }
      ],
      "gap": {
        "before": "{今|いま}、{料理|りょうり}をして",
        "answer": "います",
        "after": "。",
        "options": [
          "います",
          "あります",
          "ます"
        ],
        "why": "Doing it right now: て + いる."
      },
