      "id": "time",
      "title": "Time",
      "description": "Mornings, evenings, this week and next."
    },
    {
      "id": "actions",
      "title": "Everyday verbs",
      "description": "One kanji, then hiragana: 食べる, 飲む, 見る. The kanji carries the meaning, the kana the grammar."
    },
    {
      "id": "describe",
      "title": "Describing & feeling",
      "description": "Adjectives, and the 気 in 元気 and 天気."
    },
    {
      "id": "places",
