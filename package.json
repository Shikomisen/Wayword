{
  "name": "wayword",
  "version": "1.0.0",
  "private": true,
  "description": "A language-learning PWA for real conversation — vocabulary, sentences and connectors with SRS, reading practice and bundled audio. Japanese first, more languages to come.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "dev": "node tools/serve.mjs",
    "test": "node tools/selftest.mjs && node tools/integration-test.mjs && node tools/language-pack-test.mjs",
    "test:content": "node tools/selftest.mjs",
    "test:integration": "node tools/integration-test.mjs",
    "test:render": "node tools/render-test.mjs && node tools/sw-test.mjs",
    "audio": "node tools/generate-audio.mjs",
    "audio:check": "node tools/generate-audio.mjs --check",
    "audio:force": "node tools/generate-audio.mjs --force",
    "icons": "node tools/make-icons.mjs",
    "kana": "node tools/make-kana.mjs",
    "crossref": "node tools/crossref-kanji.mjs",
    "crossref:check": "node tools/crossref-kanji.mjs --check",
    "deploy": "node tools/deploy.mjs",
    "test:sw": "node tools/sw-test.mjs",
    "test:browser": "node tools/browser-check.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.13.0"
  }
}
